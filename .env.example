# Create a Kite Connect app at https://developers.kite.trade/apps
# Configure its redirect URL as: http://127.0.0.1:8000/auth/callback
KITE_API_KEY=replace_with_your_api_key
KITE_API_SECRET=replace_with_your_api_secret
KITE_REDIRECT_URL=http://127.0.0.1:8000/auth/callback

# Optional second provider. Create an app at https://account.upstox.com/developer/apps
# Configure its redirect URL as: http://127.0.0.1:8000/auth/upstox/callback
UPSTOX_API_KEY=replace_with_your_api_key
UPSTOX_API_SECRET=replace_with_your_api_secret
UPSTOX_REDIRECT_URL=http://127.0.0.1:8000/auth/upstox/callback

# Optional DhanHQ provider. DHAN_CLIENT_ID is always required.
# Easiest daily setup: generate a 24-hour access token in Dhan Web and paste it below.
DHAN_CLIENT_ID=replace_with_your_dhan_client_id
DHAN_ACCESS_TOKEN=

# Alternative: create Dhan app credentials and configure this callback URL:
# http://127.0.0.1:8000/auth/dhan/callback
DHAN_API_KEY=
DHAN_API_SECRET=

APP_HOST=127.0.0.1
APP_PORT=8000
CANDLE_FINALIZATION_DELAY_SECONDS=3
